# ============================================
# APPLY-TOOLS ENVIRONMENT VARIABLES
# ============================================
# Copy this file to `.env` and fill in your values.
# Get a free Gemini API key at: https://aistudio.google.com/apikey
# Get a DeepSeek account (free) at: https://chat.deepseek.com
# ============================================

# --------------------- Security ---------------------
# Generate a new one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY="django-insecure-CHANGE-ME-to-a-random-string"

ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:3030

DEBUG=True
ENABLE_DJANGO_ADMIN_PANEL=True
ENABLE_HTTPS=False


# ------------------ Application ---------------------
MEDIA_HOST=http://127.0.0.1:8000
API_VERSION='v1'
TIMEZONE=UTC


# ─── AI Provider Selection ────────────────────────────────────
# Use 'gemini' provider — FallbackClient auto-activates when AI_FALLBACK_MODELS is set
APPLYTOOLS_AI_PROVIDER=gemini

# ─── Fallback chain (try in order) ─────────────────────────────
# Order: most preferred → least preferred
# 1. gemini-3.1-flash-lite  — Google AI Studio, free tier (500 RPD, 15 RPM, 1M context)
# 2. gemini-3.5-flash-lite  — backup Gemini model if 3.1 is overloaded
# 3. gemini-3.8-flash       — last-resort Gemini
# 4. deepseek               — DeepSeek web chat (free, via Deepseek-API library) — final fallback
AI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.8-flash,deepseek

# ─── Gemini (Google AI Studio) settings ──────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Default model (gemini-3.1-flash-lite recommended: free, 500 RPD, 1M context)
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: override temperature (default: 0.7)
GEMINI_TEMPERATURE=0.7
# Optional: max output tokens (default: 8192)
GEMINI_MAX_OUTPUT_TOKENS=8192
# Optional: request timeout in seconds (default: 120)
GEMINI_TIMEOUT=120
# Max retries on transient errors (503, 429, network) — default 5
GEMINI_MAX_RETRIES=5
# Base delay (seconds) for exponential backoff — default 2.0
GEMINI_RETRY_BASE_DELAY=2.0


# ─── DeepSeek Web Chat (fallback provider) ───────────────────
# ApplyTools uses the Deepseek-API library (https://github.com/sums001/Deepseek-API)
# which bridges the free chat at chat.deepseek.com into an API.
# No API key needed — just authenticate once via:
#   python -m apps.ai.deepseek.auth
# Your browser session is then cached for future use.

# ─── Matcher tuning (shared across all AI providers) ─────────
# Delay (seconds) between match calls — protects against rate limits.
# Recommended: 20 for Gemini Flash Lite (15 RPM ≈ 4 seconds minimum, 20 for safety)
DEEPSEEK_INTER_CALL_DELAY=20

# Rotate the AI conversation every N positions to keep context fresh and
# avoid growing token cost / context overflow on long batches.
DEEPSEEK_ROTATE_EVERY=10